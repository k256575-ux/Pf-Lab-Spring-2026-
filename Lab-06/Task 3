#include <stdio.h>
int main() {
    int code;  
    do {
        printf("Enter the access code: ");
        scanf("%d", &code);

        if (code != 2006) {
            printf("Incorrect code! Try again.\n");
        }
    } while (code != 2006);  

    printf("Access granted. Door unlocked!\n");

    return 0;
}
