#include <stdio.h>

int main()
{
    int i;             
    int status;         
    int total = 0;      

    for(i = 1; i <= 25; i++)
    {
        printf("Member %d - Enter 1 if Checked In, 0 if Absent: ", i);
        scanf("%d", &status);

        
        if(status == 1)
        {
            total = total + 1;   
        }
    }
    
    printf("\nTotal Members Checked In = %d", total);

    return 0;
}
