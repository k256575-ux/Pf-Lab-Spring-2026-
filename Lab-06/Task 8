#include <stdio.h>

int main()
{
    int pin;
    int correct = 5555;

    printf("Enter PIN: ");
    scanf("%d", &pin);

    while(pin != correct)
    {
        printf("Incorrect PIN\n");
        printf("Enter PIN again: ");
        scanf("%d", &pin);
    }

    printf("Access Granted");

    return 0;
}
