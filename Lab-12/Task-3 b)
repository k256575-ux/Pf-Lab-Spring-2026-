#include <stdio.h>
#include <stdlib.h>
int main() {
    int n;
    float *sensorData;
    printf("Enter the number of sensors (N): ");
    scanf("%d", &n);
    sensorData = (float*)calloc(n, sizeof(float));
    if (sensorData == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }
    printf("\n--- Initial Buffer Values (Proof of calloc) ---\n");
    for (int i = 0; i < n; i++) {
        printf("Sensor %d: %.2f\n", i + 1, sensorData[i]);
    }
    printf("\n--- Entering Actual Sensor Readings ---\n");
    for (int i = 0; i < n; i++) {
        printf("Enter reading for sensor %d: ", i + 1);
        scanf("%f", &sensorData[i]);
    }
    printf("\nFinal Sensor Data:\n");
    for (int i = 0; i < n; i++) {
        printf("Sensor %d: %.2f\n", i + 1, sensorData[i]);
    }
    free(sensorData);
    sensorData = NULL;
    return 0;
}
