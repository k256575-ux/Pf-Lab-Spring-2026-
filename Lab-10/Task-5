#include <stdio.h>
#include <string.h>

int main() {
    char words[6][20];
    int seen[6] = {0};
    int i, j, count;

    printf("Enter 6 words (separated by spaces or enters):\n");
    for (i = 0; i < 6; i++) {
        scanf("%s", words[i]);
    }

    printf("\n--- Word Frequency Analysis ---\n");

    for (i = 0; i < 6; i++) {
        
        if (seen[i] == 1) {
            continue;
        }

        count = 1;
        
        for (j = i + 1; j < 6; j++) {
            if (strcmp(words[i], words[j]) == 0) {
                count++;
                seen[j] = 1; 
            }
        }

        printf("Word: ");
        for (int k = 0; words[i][k] != '\0'; k++) {
            printf("%c ", words[i][k]);
        }

        printf("| Frequency: %d\n", count);
    }

    return 0;
}
