P#include <stdio.h>
int main()
{
    int num[5];
    int i;
    int last;
    printf("Enter 5 numbers:\n");

    for(i = 0; i < 5; i++)
    {
        printf("Enter number %d: ", i + 1);
        scanf("%d", &num[i]);
    }

    last = num[4];

    for(i = 4; i > 0; i--)
    {
        num[i] = num[i - 1];
    }

    num[0] = last;

    printf("\nArray after shifting:\n");

    for(i = 0; i < 5; i++)
    {
        printf("%d ", num[i]);
    }

    return 0;
}
