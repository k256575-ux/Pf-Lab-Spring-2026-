#include <stdio.h>
int main() {
    int pass[10], fail[10], p=0, f=0, mark, i;
    float avgPass=0, avgFail=0;

    while(1) {
        scanf("%d", &mark);
        if(mark==-1) break;
        if(mark>=5 && mark<=10) { pass[p++] = mark; avgPass+=mark; }
        else if(mark>=0 && mark<5) { fail[f++] = mark; avgFail+=mark; }
    }

    printf("Pass Marks: ");
    for(i=0; i<p; i++) printf("%d ", pass[i]);
    if(p>0) printf("\nAverage Pass = %.2f", avgPass/p);

    printf("\nFail Marks: ");
    for(i=0; i<f; i++) printf("%d ", fail[i]);
    if(f>0) printf("\nAverage Fail = %.2f", avgFail/f);

    return 0;
}
