#include <stdio.h>
int main()
{
    char text[100];       
    int i = 0;            

    printf("Enter a sentence: ");
    scanf("%[^\n]", text);   
    printf("Non-alphabet characters are: ");
    while(text[i] != '\0')
    {
        char ch = text[i];


        if(!( (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ))
        {
            printf("%c ", ch);
        }

        i = i + 1;  
    }

    return 0;
}
