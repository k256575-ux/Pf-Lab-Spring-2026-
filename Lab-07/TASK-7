#include <stdio.h>
int main()
{
    int arr[10];      
    int i, j;

    printf("Enter 10 numbers:\n");
    for(i = 0; i < 10; i++)
    {
        printf("Number %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

    for(i = 0; i < 10; i++)
    {
        j = i + 1;  

        while(j < 10)
        {
            if(arr[i] == arr[j])
            {
                arr[j] = -1;  
            }
            j = j + 1;  
        }
    }

    printf("\nArray after replacing duplicates with -1:\n");
    for(i = 0; i < 10; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
