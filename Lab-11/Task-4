#include <stdio.h>
#include <string.h>
struct Patient {
    char name[50];
    int age;
    char bloodType[5];
    int patientID;
    char diagnosis[100];
};
void displayAll(struct Patient p[], int n) {
    printf("\n--- Patient Registry ---\n");
    printf("%-10s %-20s %-5s %-10s %-20s\n", "ID", "Name", "Age", "Blood", "Diagnosis");
    printf("\n");
    for (int i = 0; i < n; i++) {
        printf("%-10d %-20s %-5d %-10s %-20s\n", 
               p[i].patientID, p[i].name, p[i].age, p[i].bloodType, p[i].diagnosis);
    }
}
void searchByID(struct Patient p[], int n, int id) {
    int found = 0;
    for (int i = 0; i < n; i++) {
        if (p[i].patientID == id) {
            printf("\nRecord Found:\n");
            printf("Name: %s\nAge: %d\nBlood Type: %s\nDiagnosis: %s\n", 
                   p[i].name, p[i].age, p[i].bloodType, p[i].diagnosis);
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("\nPatient with ID %d not found.\n", id);
    }
}
int main() {
    struct Patient clinic[5]; 
    int searchID;
    for (int i = 0; i < 5; i++) {
        printf("\nEntering details for Patient %d\n", i + 1);
        printf("ID: ");
        scanf("%d", &clinic[i].patientID);
        getchar(); 
        printf("Name: ");
        fgets(clinic[i].name, 50, stdin);
        clinic[i].name[strcspn(clinic[i].name, "\n")] = 0; 
        printf("Age: ");
        scanf("%d", &clinic[i].age);
        getchar(); 
        printf("Blood Type (e.g., A+): ");
        scanf("%s", clinic[i].bloodType);
        getchar();
        printf("Diagnosis: ");
        fgets(clinic[i].diagnosis, 100, stdin);
        clinic[i].diagnosis[strcspn(clinic[i].diagnosis, "\n")] = 0;
    }
    displayAll(clinic, 5);
    printf("\nEnter Patient ID to search: ");
    scanf("%d", &searchID);
    searchByID(clinic, 5, searchID);
    return 0;
}
