#include <stdio.h>
int countWays(int n) {
    if (n == 0) return 1; 
    if (n < 0)  return 0; 
    return countWays(n - 1) + countWays(n - 2);
}
void printPaths(int n, int path[], int index) {
    if (n == 0) {
        for (int i = 0; i < index; i++) {
            printf("%d%s", path[i], (i == index - 1) ? "" : "+");
        }
        printf("\n");
        return;
    }
    if (n < 0) return;
    path[index] = 1;
    printPaths(n - 1, path, index + 1);
    path[index] = 2;
    printPaths(n - 2, path, index + 1);
}
int main() {
    int n;
    int pathStorage[15]; 

    printf("Enter N (1-15): ");
    scanf("%d", &n);

    if (n < 1 || n > 15) {
        printf("Please enter a number between 1 and 15.\n");
    } else {
        printf("Total distinct ways: %d\n", countWays(n));
        printf("Unique paths:\n");
        printPaths(n, pathStorage, 0);
    }
    return 0;
}
