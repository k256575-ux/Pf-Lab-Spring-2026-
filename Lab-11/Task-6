#include <stdio.h>
#include <string.h>
struct Order {
    int orderID;
    char customerName[50];
    char productName[50];
    int quantity;
    float unitPrice;
    char status[20]; 
};

float computeTotal(struct Order o) {
    return o.quantity * o.unitPrice;
}

void filterByStatus(struct Order orders[], int n, char *searchStatus) {
    int found = 0;
    printf("\n- Orders with Status: %s -\n", searchStatus);
    for (int i = 0; i < n; i++) {
        if (strcmp(orders[i].status, searchStatus) == 0) {
            printf("Order ID: %d | Customer: %s | Product: %s\n", 
                   orders[i].orderID, orders[i].customerName, orders[i].productName);
            found = 1;
        }
    }
    if (!found) {
        printf("No orders found with that status.\n");
    }
}

int main() {
    struct Order list[4]; 
    char statusToSearch[20];

    for (int i = 0; i < 4; i++) {
        printf("\n-Enter Details for Order %d -\n", i + 1);
        
        printf("Order ID: ");
        scanf("%d", &list[i].orderID);
        getchar();

        printf("Customer Name: ");
        fgets(list[i].customerName, 50, stdin);
        list[i].customerName[strcspn(list[i].customerName, "\n")] = 0;

        printf("Product Name: ");
        fgets(list[i].productName, 50, stdin);
        list[i].productName[strcspn(list[i].productName, "\n")] = 0;

        printf("Quantity: ");
        scanf("%d", &list[i].quantity);

        printf("Unit Price: ");
        scanf("%f", &list[i].unitPrice);
        getchar();

        printf("Status (Pending/Shipped/Delivered): ");
        scanf("%s", list[i].status);
    }

    printf("\n-Itemized Bills-\n");
    for (int i = 0; i < 4; i++) {
        float total = computeTotal(list[i]);
        printf("Order #%d (%s): Total Bill = $%.2f\n", 
               list[i].orderID, list[i].productName, total);
    }

    printf("\nEnter status to filter (Pending/Shipped/Delivered): ");
    scanf("%s", statusToSearch);
    filterByStatus(list, 4, statusToSearch);
    return 0;
}
