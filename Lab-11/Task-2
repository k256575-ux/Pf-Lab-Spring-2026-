#include <stdio.h>
#include <ctype.h> 
int countUpperAndDigits(char *str) {
    if (str[0] == '\0') {
        return 0;
    }
    int found = 0;
    if (isupper(str[0]) || isdigit(str[0])) {
        found = 1;
    }
    return found + countUpperAndDigits(str + 1);
}
int main() {
    char password[100];

    printf("Enter your password: ");
    scanf("%s", password);
    int totalCount = countUpperAndDigits(password);
    printf("Total uppercase letters and digits found: %d\n", totalCount);
    return 0;
}
