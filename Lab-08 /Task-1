#include <stdio.h>
int main() {
    int marks[4][3] = {
        {80, 75, 90},
        {60, 70, 85},
        {88, 92, 79},
        {55, 65, 70}
    };

    int i, j;

    for(i = 0; i < 4; i++) {
        int sum = 0;

        for(j = 0; j < 3; j++) {
            sum = sum + marks[i][j];
        }

        printf("Student %d total = %d\n", i+1, sum);
    }

    printf("\n");

    
    for(j = 0; j < 3; j++) {

        int sum = 0;

        for(i = 0; i < 4; i++) {
            sum = sum + marks[i][j];
        }

        printf("Subject %d average = %d\n", j+1, sum / 4);
    }

    return 0;
}
