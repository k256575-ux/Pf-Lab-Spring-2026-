#include <stdio.h>
int main() {

    int a[5][5], b[5][5];
    int r, c;
    int i, j;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);

    printf("Enter matrix A:\n");
    for(i=0;i<r;i++){
        for(j=0;j<c;j++){
            scanf("%d", &a[i][j]);
        }
    }

    int square = 0;
    int zero = 1;
    int identity = 1;
    int diagonal = 1;
    int scalar = 1;
    int upper = 1;
    int lower = 1;
    int symmetric = 1;
    int skew = 1;


    if(r == c)
        square = 1;

    
    for(i=0;i<r;i++){
        for(j=0;j<c;j++){

            
            if(a[i][j] != 0)
                zero = 0;
 
            if(i==j){
                if(a[i][j] != 1)
                    identity = 0;
            } else {
                if(a[i][j] != 0)
                    identity = 0;
            }

        
            if(i != j && a[i][j] != 0)
                diagonal = 0;

        
            if(i != j && a[i][j] != 0)
                scalar = 0;

            if(i==j && a[i][j] != a[0][0])
                scalar = 0;

        
            if(i > j && a[i][j] != 0)
                upper = 0;

            
            if(i < j && a[i][j] != 0)
                lower = 0;
        }
    }

    
    if(square){
        for(i=0;i<r;i++){
            for(j=0;j<c;j++){

                if(a[i][j] != a[j][i])
                    symmetric = 0;

                if(a[i][j] != -a[j][i])
                    skew = 0;
            }
        }
    } else {
        symmetric = 0;
        skew = 0;
    }

    
    int singular = 0;

    if(r==1 && c==1){
        if(a[0][0] == 0)
            singular = 1;
    }
    else if(r==2 && c==2){
        int det = a[0][0]*a[1][1] - a[0][1]*a[1][0];
        if(det == 0)
            singular = 1;
    }

    
    int equal = 1;

    printf("\nEnter matrix B:\n");
    for(i=0;i<r;i++){
        for(j=0;j<c;j++){
            scanf("%d", &b[i][j]);
        }
    }

    for(i=0;i<r;i++){
        for(j=0;j<c;j++){
            if(a[i][j] != b[i][j])
                equal = 0;
        }
    }

    
    printf("\nMatrix Types:\n");

    if(square) printf("Square Matrix\n");
    else printf("Rectangular Matrix\n");

    if(r==1) printf("Row Matrix\n");
    if(c==1) printf("Column Matrix\n");

    if(zero) printf("Zero Matrix\n");
    if(zero) printf("Null Matrix\n");

    if(identity) printf("Identity Matrix\n");
    if(diagonal) printf("Diagonal Matrix\n");
    if(scalar) printf("Scalar Matrix\n");
    if(upper) printf("Upper Triangular Matrix\n");
    if(lower) printf("Lower Triangular Matrix\n");
    if(symmetric) printf("Symmetric Matrix\n");
    if(skew) printf("Skew-Symmetric Matrix\n");

    if(r==1 && c==1){
        if(singular) printf("Singular Matrix\n");
        else printf("Non-Singular Matrix\n");
    }
    else if(r==2 && c==2){
        if(singular) printf("Singular Matrix\n");
        else printf("Non-Singular Matrix\n");
    }

    if(equal) printf("Equal Matrix (A == B)\n");
    else printf("Not Equal Matrix\n");

    return 0;
}
