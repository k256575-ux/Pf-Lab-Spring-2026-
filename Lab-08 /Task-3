#include <stdio.h>
int main() {
    int temp[7][3] = {
        {30, 35, 28},
        {32, 36, 29},
        {31, 34, 27},
        {33, 37, 30},
        {29, 33, 26},
        {28, 32, 25},
        {34, 38, 31}
    };

    int i, j;

    
    int max = temp[0][0];

    for(i = 0; i < 7; i++) {
        for(j = 0; j < 3; j++) {

            if(temp[i][j] > max) {
                max = temp[i][j];
            }

        }
    }

    printf("Highest temperature = %d\n", max);
    for(i = 0; i < 7; i++) {

        int sum = 0;

        for(j = 0; j < 3; j++) {
            sum = sum + temp[i][j];
        }

        printf("Day %d average = %d\n", i+1, sum / 3);
    }

    return 0;
}
