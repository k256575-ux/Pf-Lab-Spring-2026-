#include <stdio.h>
float applyDiscount(float price, int tier);
void printInvoice(float original, float discounted);
int main() {
    float userPrice;
    int userTier;

    printf("Welcome to the Clothing Store!\n");
    printf("Enter the item price: ");
    scanf("%f", &userPrice);
    
    printf("Enter membership (1=Bronze, 2=Silver, 3=Gold, 4=Platinum): ");
    scanf("%d", &userTier);

    float finalPrice = applyDiscount(userPrice, userTier);

    printInvoice(userPrice, finalPrice);

    return 0;
}

float applyDiscount(float price, int tier) {
    float discountedPrice;

    if (tier == 1) {
        discountedPrice = price * 0.95; 
    } else if (tier == 2) {
        discountedPrice = price * 0.90; 
    } else if (tier == 3) {
        discountedPrice = price * 0.80; 
    } else if (tier == 4) {
        discountedPrice = price * 0.70; 
    } else {
        discountedPrice = price; 
    }

    return discountedPrice;
}

void printInvoice(float original, float discounted) {
    float delivery = 0;

    if (discounted < 2000) {
        delivery = 150;
    }

    printf("\n--- CUSTOMER INVOICE ---\n");
    printf("Old Price: Rs. %.2f\n", original);
    printf("Discounted: Rs. %.2f\n", discounted);
    
    if (delivery > 0) {
        printf("Delivery: Rs. %.2f\n", delivery);
    } else {
        printf("Delivery: FREE\n");
    }

    printf("Total to pay: Rs. %.2f\n", discounted + delivery);
    printf("\n");
} 
