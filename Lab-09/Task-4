#include <stdio.h>
int validatePIN(int storedPIN, int enteredPIN);
int main() {
    int storedPIN = 2486; 
    int userInput;
    int attempts;
    int success = 0; 

    printf(" Welcome to Smart ATM \n");

    for (attempts = 1; attempts <= 3; attempts++) {
        printf("Enter your 4-digit PIN: ");
        scanf("%d", &userInput);

        if (validatePIN(storedPIN, userInput) == 1) {
            printf("Access granted. Welcome!\n");
            success = 1; 
            break;       
        } else {
            
            if (attempts < 3) {
                printf("Incorrect PIN. You have %d attempts left.\n", 3 - attempts);
            }
        }
    }

    if (success == 0) {
        printf("\nCard blocked. Contact your bank.\n");
    }

    return 0;
}

int validatePIN(int storedPIN, int enteredPIN) {
    if (storedPIN == enteredPIN) {
        return 1; 
    } else {
        return 0; 
    }
}
