#include <stdio.h>
int totalRuns(int arr[], int n);
int highestScore(int arr[], int n);
int aboveAverage(int arr[], int n, float avg);

int main() {
    int scores[10];
    int i;

    printf("--- Cricket Batting Analytics ---\n");
    printf("Enter runs scored in 10 consecutive matches:\n");

    for (i = 0; i < 10; i++) {
        printf("Match %d: ", i + 1);
        scanf("%d", &scores[i]);
    }

    int total = totalRuns(scores, 10);
    int high = highestScore(scores, 10);
    
    float avg = (float)total / 10;
    
    int betterThanAvg = aboveAverage(scores, 10, avg);

    printf("\nPerformance Report\n");
    printf("Total Runs Scored: %d\n", total);
    printf("Average Runs:      %.2f\n", avg);
    printf("Highest Score:     %d\n", high);
    printf("Matches above avg: %d\n", betterThanAvg);

    return 0;
}

int totalRuns(int arr[], int n) {
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum = sum + arr[i];
    }
    return sum;
}

int highestScore(int arr[], int n) {
    int max = arr[0];
    for (int i = 1; i < n; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }
    return max;
}

int aboveAverage(int arr[], int n, float avg) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] > avg) {
            count++;
        }
    }
    return count;
}
