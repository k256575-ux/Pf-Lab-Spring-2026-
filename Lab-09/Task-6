#include <stdio.h>
float totalRevenue(float bills[], int n);
int bestTable(float bills[], int n);
int isProfitable(float total);

int main() {
    float bills[5];
    int i;

    printf("Restaurant Nightly Revenue Tracker\n");
    for (i = 0; i < 5; i++) {
        printf("Enter bill amount for Table %d: Rs. ", i + 1);
        scanf("%f", &bills[i]);
    }

    float totalSum = totalRevenue(bills, 5);
    int topTableIndex = bestTable(bills, 5);
    int profitCheck = isProfitable(totalSum);
    printf("\n\n");
    printf("Total Nightly Revenue: Rs. %.2f\n", totalSum);
    
    printf("Highest Revenue Table: Table %d\n", topTableIndex + 1);

    if (profitCheck == 1) {
        printf("Verdict: The night was PROFITABLE!\n");
    } else {
        printf("Verdict: The night was NOT PROFITABLE.\n");
    }
    printf("\n");

    return 0;
}

float totalRevenue(float bills[], int n) {
    float sum = 0;
    for (int i = 0; i < n; i++) {
        sum = sum + bills[i];
    }
    return sum;
}

int bestTable(float bills[], int n) {
    int maxIdx = 0; 
    for (int i = 1; i < n; i++) {
        if (bills[i] > bills[maxIdx]) {
            maxIdx = i; 
        }
    }
    return maxIdx;
}

int isProfitable(float total) {
    if (total > 10000.0) {
        return 1;
    } else {
        return 0; 
    }
}

 
