#include <stdio.h>
int basicAttack(int dmg, int hp) {
    printf("You used Basic Attack\n");
    return hp - dmg;
}


int powerStrike(int dmg, int hp) {
    printf("You used Power Strike\n");
    return hp - (int)(dmg * 2.5);
}

int heal(int dmg, int hp) {
    printf("You used Heal\n");
    return hp + 20;
}
int poisonAttack(int dmg, int hp) {
    printf("You used Poison Attack\n");
    printf("Enemy is poisoned!\n");
    return hp - (dmg / 2);
}

int main() {

    int hp = 100;
    int dmg = 25;

    int (*action)(int, int);

    int choice;
    for (int turn = 1; turn <= 3; turn++) {

        printf("\n--- Turn %d ---\n", turn);
        printf("1. Basic Attack\n");
        printf("2. Power Strike\n");
        printf("3. Heal\n");
        printf("4. Poison Attack\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        
        if (choice == 1)
            action = basicAttack;
        else if (choice == 2)
            action = powerStrike;
        else if (choice == 3)
            action = heal;
        else if (choice == 4)
            action = poisonAttack;
        else {
            printf("Wrong choice! Try again.\n");
            turn--;  
            continue;
        }

        hp = action(dmg, hp);

        printf("Updated HP: %d\n", hp);
    }

    return 0;
}
